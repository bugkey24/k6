# K6 Environment Variables Example
# Copy this file to .env and update values as needed
# Then use: k6 run script.js --env-file=.env

# Target URL for testing (required)
# Default: http://localhost:3000
# Change this to your API endpoint
BASE_URL=http://localhost:3000

# HTTP request timeout (default: 30s)
TIMEOUT=30s

# Minimum think time between requests in seconds (default: 1)
THINK_TIME_MIN=1

# Maximum think time between requests in seconds (default: 3)
THINK_TIME_MAX=3

# Skip TLS certificate verification (default: true)
# Needed for self-signed certs or IP targets without IP SANs
# Set to false to enforce strict certificate validation
SKIP_TLS_VERIFY=true

# Extreme plateau test (tests/extreme-plateau-test.js)
# Flat extreme load — no VU fluctuation; adjustable time range
TARGET_VUS=300
EXTREME_DURATION=10m
RAMP_IN=0s

# K6 Cloud configuration (optional)
# K6_CLOUD_TOKEN=your_token_here
# K6_CLOUD_PROJECT_ID=your_project_id

# Custom headers (if needed, modify in config.js)
# CUSTOM_HEADER_VALUE=your_value
